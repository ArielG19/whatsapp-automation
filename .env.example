# Copia este archivo como .env y rellena los valores.
# El archivo .env nunca se sube a GitHub.

# Clave de la API de Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# Contraseña del panel (mínimo 10 caracteres).
# - En tu ordenador es opcional: sin ella, el panel solo es accesible desde este equipo.
# - En un servidor es OBLIGATORIA: sin ella la app no abre el panel ni conecta WhatsApp.
PANEL_PASSWORD=

# --- Solo para servidores (en Hostinger se detecta todo automáticamente) ---
# Dominio(s) del panel, separados por comas. Obligatorio fuera de Hostinger.
# APP_DOMAIN=panel.midominio.com
# Carpeta persistente para la sesión de WhatsApp y los datos.
# DATA_DIR=/ruta/persistente
# Zona horaria de los recordatorios (por defecto Europe/Madrid).
# APP_TIMEZONE=Europe/Madrid

# --- Base de datos MySQL (opcional; sin ella se usa data/store.json) ---
# En Hostinger se rellenan solas al crear la base de datos de la web.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
